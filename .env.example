# .env.example — template, committed to repo
# Copy to .env (local dev) or .env.remote (remote PG) and fill in real values.
#
# URL-encode special characters in passwords:
#   '!' -> %21    '#' -> %23    '@' -> %40
#   ':' -> %3A    '/' -> %2F    '?' -> %3F
#
# Required. No application default exists; missing value fails at startup.
DATABASE_URL=postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@HOST:PORT/DBNAME

# Required. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# JWT config (defaults are safe)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (JSON list of origins)
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=False

# Parser
PARSER_VERSION=v2.0.0
MAX_UPLOAD_SIZE_MB=50

# ML
ML_ARTIFACTS_BASE=src/rcm/ml/artifacts
MIN_TRAINING_SIZE=1000
PRECISION_FLOOR=0.85
LOW_PROB_CUTOFF=0.05

# Background jobs (set when arq is wired up)
REDIS_URL=redis://localhost:6379/0

# RAG (off by default; turn on when the RAG provider is built)
RAG_ENABLED=False
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=BAAI/bge-m3
PGVECTOR_DIMENSIONS=1024

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
