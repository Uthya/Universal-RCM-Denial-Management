# Secrets — only .env.example is committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual envs
.venv/
venv/
env/
ENV/

# uv / pip
.uv-cache/
uv.lock

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

